# Copy to `.env.local` and fill in real values.
# Do not commit secrets. Public profile URLs are not secrets, but keep them out of git if you prefer.

# Canonical site URL (no trailing slash). Use your custom domain when you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public profile links. Leave empty to hide those buttons.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Optional public email. Leave empty until you want it on the site.
NEXT_PUBLIC_EMAIL=
